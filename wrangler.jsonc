{
  // Cloudflare Worker replacing the Express server (server.js) that ran on Zeabur.
  // API keys are secrets: npx wrangler secret put YOUTUBE_API_KEY (and the other names in .env.example).
  "name": "chuckleclips",
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "routes": [{ "pattern": "chuckleclips.thebooleanjulian.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
